<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit chat</title>
</head>
<body>
    <h1>Edit your message..</h1>
    <p>Edit your chat: <%= chat._id %></p>
    <p>This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    <form method="post" action="/chats/<%= chat._id %>?_method=put">
        <textarea name="msg" rows="5" cols="28" ><%= chat.msg %></textarea>
        <br />
        <button>Edit</button>
    </form>
</body>
</html>